{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Domain",
  "type": "object",
  "required": [
    "domain_id",
    "macroarea_id",
    "name"
  ],
  "properties": {
    "domain_id": {
      "type": "string"
    },
    "macroarea_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "legacy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
