{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dependency",
  "type": "object",
  "required": [
    "dependency_id",
    "source_artifact_id",
    "target_artifact_id",
    "relation"
  ],
  "properties": {
    "dependency_id": {
      "type": "string",
      "pattern": "^DEP-[0-9]{6}$"
    },
    "source_artifact_id": {
      "type": "string"
    },
    "target_artifact_id": {
      "type": "string"
    },
    "relation": {
      "enum": [
        "DEPENDS_ON",
        "BLOCKS",
        "PRODUCES",
        "CONSUMES",
        "DERIVES_FROM"
      ]
    },
    "mandatory": {
      "type": "boolean"
    },
    "gate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_status": {
      "type": "string"
    },
    "status": {
      "const": "ACTIVE"
    }
  }
}
