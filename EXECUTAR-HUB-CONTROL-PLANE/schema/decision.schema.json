{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision",
  "type": "object",
  "required": [
    "decision_id",
    "topic",
    "decision"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "requires_human_validation": {
      "type": "boolean"
    },
    "adr_ref": {
      "type": "string"
    }
  }
}
