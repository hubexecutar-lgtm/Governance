{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gate",
  "type": "object",
  "required": [
    "gate_id",
    "name",
    "scope"
  ],
  "properties": {
    "gate_id": {
      "type": "string",
      "pattern": "^G[0-9]{2}$"
    },
    "name": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "PROGRAM",
        "PORTFOLIO",
        "ARTIFACT"
      ]
    },
    "required_artifact_types": {
      "type": "array"
    },
    "required_statuses": {
      "type": "array"
    },
    "decision": {
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "WAIVED"
      ]
    },
    "evidence_ids": {
      "type": "array"
    }
  }
}
