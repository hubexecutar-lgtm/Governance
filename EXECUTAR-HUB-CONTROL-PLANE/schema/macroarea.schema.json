{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Macroarea",
  "type": "object",
  "required": [
    "macroarea_id",
    "name"
  ],
  "properties": {
    "macroarea_id": {
      "type": "string",
      "pattern": "^A[0-9]{2}$"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
