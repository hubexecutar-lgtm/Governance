{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Document",
  "type": "object",
  "required": [
    "document_id",
    "level",
    "scope_id"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "level": {
      "enum": [
        "MACROAREA",
        "PORTFOLIO",
        "PROGRAM"
      ]
    },
    "scope_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "derives_from": {
      "type": "string"
    }
  }
}
